@baseUrl = http://localhost:5080
@apiKey = super-secret-key

GET {{baseUrl}}/health
Accept: application/json

###

GET {{baseUrl}}/api/status
Accept: application/json
X-API-KEY: {{apiKey}}

###

POST {{baseUrl}}/api/update/check
Accept: application/json
X-API-KEY: {{apiKey}}

###

POST {{baseUrl}}/api/update/trigger
Accept: application/json
Content-Type: application/json
X-API-KEY: {{apiKey}}

###

POST {{baseUrl}}/api/update/trigger/nginx?includeDependencies=true
Accept: application/json
X-API-KEY: {{apiKey}}
